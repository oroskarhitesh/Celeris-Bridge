# Copy to .env. Everything this project reads is prefixed CB_.

# The Anthropic SDK reads this itself; the project never holds it, so it
# cannot end up in a log line.
ANTHROPIC_API_KEY=sk-ant-...

# voyage | openai | development
# "development" is a word-hash, not a language model: it cannot match a
# synonym. Fine for local work, never for a real workspace.
CB_EMBEDDINGS=development
CB_EMBEDDING_MODEL=
CB_EMBEDDING_DIMENSIONS=
# Read by the adapter you choose, not by this project's settings.
VOYAGE_API_KEY=
OPENAI_API_KEY=

# memory | mongo   "memory" needs nothing but the key above.
CB_ADAPTERS=memory

# Which definition to serve, and what the agent calls the company.
CB_DEFINITION=marketing_v1
CB_COMPANY=Acme

# Overrides the definition's own model, for trying one without editing a
# published document. Leave blank to use the definition's.
CB_CHAT_MODEL=

CB_TIME_ZONE=Europe/London
CB_MAX_REPLY_TOKENS=700

# --- the HTTP API ---
# Bearer tokens for the admin API: token:workspace per entry, comma
# separated, and a third field of "platform" grants the platform role.
#   CB_API_TOKENS=tok_live_a1:ws_acme,tok_plat_b2::platform
CB_API_TOKENS=
# Development only. With no tokens configured, every request is treated as an
# admin of this workspace. Warns on every start-up; leave it blank and the
# admin API refuses everything, which is the safe default.
CB_DEV_WORKSPACE=
# Where the admin app is served from, comma separated. The widget routes
# answer any origin and never allow credentials; these do the reverse.
CB_ADMIN_ORIGINS=http://localhost:5173

# Only read when CB_ADAPTERS=mongo.
CB_MONGO_URL=
CB_MONGO_DATABASE=celeris_bridge

# Where uploaded documents are kept -- the originals, not the passages.
# Blank keeps them in the process, which loses every file on restart.
CB_DOCUMENT_ROOT=

# Where the backend is. No trailing slash.
VITE_API_URL=http://127.0.0.1:8000

# A development bearer token, pre-filled into the session so the app is usable
# before real authentication exists. It is a convenience, not a secret store:
# anything here is in the built JavaScript. Leave it empty and paste a token in
# the UI instead when the token belongs to somebody real.
VITE_API_TOKEN=
